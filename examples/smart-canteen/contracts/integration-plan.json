{
  "feature": "smart-canteen-core-workflow",
  "contract": "smart-canteen.openapi.yaml",
  "pages": [
    {
      "page": "MenuApprovalPage",
      "operations": ["submitMenu", "decideMenuApproval"],
      "states": ["loading", "ready", "submitting", "success", "business-error"],
      "dependencies": ["RecipeImportPage:imported"]
    },
    {
      "page": "RecipeImportPage",
      "operations": ["importMenuRecipe"],
      "states": ["loading", "ready", "submitting", "success", "business-error"],
      "dependencies": []
    },
    {
      "page": "ProcurementWorkbenchPage",
      "operations": ["generateProcurementPlan", "receiveInventory"],
      "states": ["loading", "empty", "ready", "submitting", "business-error"],
      "dependencies": ["MenuApprovalPage:APPROVED"]
    },
    {
      "page": "LedgerAlertPage",
      "operations": ["getCurrentLedgerAlert", "completeLedgerRecord"],
      "states": ["loading", "empty", "ready", "submitting", "business-error"],
      "dependencies": ["ProcurementWorkbenchPage:receipt-completed"]
    },
    {
      "page": "AlertCenterPage",
      "operations": ["reportAlert", "disposeAlert", "queryAlerts"],
      "states": ["loading", "empty", "ready", "submitting", "business-error"],
      "dependencies": ["LedgerAlertPage:ledger-warning", "BrightKitchenAdapter:warning", "MorningInspectionAdapter:warning"]
    }
  ],
  "verification": [
    "OpenAPI normalization",
    "generated client compile",
    "generated fetch contract tests",
    "Vue page loading/empty/error tests",
    "Spring HTTP workflow tests",
    "candidate replay and provenance audit"
  ],
  "assumptions": [
    "The demo persists one seeded menu, inventory, receipt idempotency and ledger state in MySQL; Redis and RabbitMQ are provisioned but not yet connected to business ports.",
    "Bright-kitchen, morning-inspection and district-platform network clients are represented as replaceable ports; credentials and vendor contracts are required before implementing adapters.",
    "The alert center accepts a normalized report and owns idempotent ingestion, disposal and query; source adapters remain outside this phase-4 slice.",
    "All quantities are normalized server-side to g, ml or count."
  ]
}
